<Project>
  <!-- Single authored application release identity. Inno Setup derives its
       version from the published executable; Help and updates use AppVersion. -->
  <PropertyGroup>
    <OpsisAppVersion>3.0.0.3200</OpsisAppVersion>
    <Version>$(OpsisAppVersion)</Version>
    <FileVersion>$(OpsisAppVersion)</FileVersion>
    <InformationalVersion>$(OpsisAppVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
