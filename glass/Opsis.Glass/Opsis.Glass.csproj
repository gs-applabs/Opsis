<Project Sdk="Microsoft.NET.Sdk">
  <!-- Opsis.Glass: the glass layer of the new DeskContainers core, widgets and DeskStrip. GPU (Direct2D + DirectComposition + DXGI duplication), no UI toolkit. Windows 11 only. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Opsis.Glass</RootNamespace>
    <AssemblyName>Opsis.Glass</AssemblyName>
    <Version>0.1.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.6.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Opsis.Glass.Tests" />
  </ItemGroup>
</Project>
