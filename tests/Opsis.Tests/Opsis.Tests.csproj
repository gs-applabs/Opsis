<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../MotionDeskStudio.csproj" />
    <ProjectReference Include="../../core/Opsis.Lockscreen.Core/Opsis.Lockscreen.Core.csproj" />
    <!-- real plugin DLLs for the load-matrix tests (built into tests/PluginFixtures/out) and the old contract 0.8.0.0 that stands for Opsis 2.4.6 -->
    <None Include="Fixtures/**" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../PluginFixtures/StubOldPlugin/StubOldPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PluginFixtures/StubNewPlugin/StubNewPlugin.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../PluginFixtures/StubNewLitePlugin/StubNewLitePlugin.csproj" ReferenceOutputAssembly="false" />
    <!-- the plugin contract, for the plugin tests (the host shares this very assembly with every plugin) -->
    <Reference Include="Opsis.UI">
      <HintPath>../../libs/Opsis.UI.dll</HintPath>
    </Reference>
    <Reference Include="OpsisNewsCrawler.Plugin.Abstractions">
      <HintPath>../../libs/OpsisNewsCrawler.Plugin.Abstractions.dll</HintPath>
    </Reference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" ExcludeAssets="all" GeneratePathProperty="true" />
    <Reference Include="Microsoft.Web.WebView2.Core"><HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.Core.dll</HintPath></Reference>
    <Reference Include="Microsoft.Web.WebView2.WinForms"><HintPath>$(PkgMicrosoft_Web_WebView2)/lib_manual/netcoreapp3.0/Microsoft.Web.WebView2.WinForms.dll</HintPath></Reference>
  </ItemGroup>
</Project>
