<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.87</WindowsSdkPackageVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets/Opsis.ico</ApplicationIcon>
    <RootNamespace>MotionDesk</RootNamespace>
    <AssemblyName>Opsis</AssemblyName>
    <Product>Opsis - Desktop Customization</Product>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Opsis.UI" />
    <!-- tests\ holds separate projects (e.g. AtomicWriteCrashHarness with top-level statements): they must NEVER be compiled into the app, or their Main replaces the real entry point and Opsis exits with code 2 at start-up -->
    <Compile Remove="tests/**" />
    <!-- External GitHub workspaces for interoperability tests live under
         _compat/. SDK default globs must not compile their source or package
         their transient assets into the Opsis executable. -->
    <Compile Remove="_compat/**" />
    <EmbeddedResource Remove="_compat/**" />
    <None Remove="_compat/**" />
    <Content Remove="_compat/**" />
    <EmbeddedResource Remove="tests/**" />
    <None Remove="tests/**" />
    <Reference Include="lib/*.dll" Exclude="lib/WebView2Loader.dll;lib/libMonoPosixHelper.dll;lib/MonoPosixHelper.dll">
      <Private>true</Private>
    </Reference>
    <None Update="lib/WebView2Loader.dll;lib/libMonoPosixHelper.dll;lib/MonoPosixHelper.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
    <None Update="assets/**;locales/**;suite/**;wallpapers/**;widget-sdk/**;LICENSE;THIRD_PARTY_NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Update="lib/HidSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="src/Widgets/wallpaper/**;src/Widgets/sysmon/**" />
    <Content Include="src/Widgets/wallpaper/**" CopyToOutputDirectory="PreserveNewest" Link="widgets/wallpaper/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="src/Widgets/sysmon/**" CopyToOutputDirectory="PreserveNewest" Link="widgets/sysmon/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="src/Widgets/Data/gazetteer-gr.tsv.gz" LogicalName="gazetteer-gr.tsv.gz" />
    <EmbeddedResource Include="src/Widgets/wallpaper/scenes/capitals.json" LogicalName="opsis-capitals.json" />
    <EmbeddedResource Include="src/Widgets/wallpaper/scenes/islands.json" LogicalName="opsis-islands.json" />
    <EmbeddedResource Include="src/Music/suite-visualizers.js" LogicalName="OpsisMusicOverlay.suite-visualizers.js" />
    <EmbeddedResource Include="src/Music/wallpaper-music.js" LogicalName="OpsisMusicOverlay.wallpaper-music.js" />
  </ItemGroup>
</Project>
