<Project Sdk="Microsoft.NET.Sdk">
  <!-- Minimal elevated helper of the animated lock screen feature: one command word (apply | restore | disable-feature), no UI, no network. Opsis itself never runs elevated. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OpsisLockHelper</AssemblyName>
    <RootNamespace>Opsis.LockHelper</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\core\Opsis.Lockscreen.Core\Opsis.Lockscreen.Core.csproj" />
  </ItemGroup>
</Project>
